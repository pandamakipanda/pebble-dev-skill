# 统一换行，避免 Windows 用户 clone 后 .c/.h/.py 出现 CRLF（会让 lint 与测试产生噪音）
* text=auto eol=lf

# 二进制产物：不做换行转换、不支持文本 diff
*.pbw       binary
*.png       binary
*.pbz       binary
*.bin       binary
*.tar.gz    binary
*.elf       binary

# 让 GitHub 语言统计更准确：shell 脚本按 shell 计
*.sh        text eol=lf
measure.sh  text eol=lf

# 隐藏生成物在 diff 里的噪音
build/**    linguist-generated=true
